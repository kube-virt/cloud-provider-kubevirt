FROM golang:1.24 as go
ENV GO111MODULE=on
ENV CGO_ENABLED=0
ENV GOBIN=/bin

FROM go as build
ARG TARGETPLATFORM
ARG TARGETARCH
WORKDIR /build
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -mod=vendor -a -o /bin/kubevirt-cloud-controller-manager ./cmd/kubevirt-cloud-controller-manager

FROM registry.access.redhat.com/ubi9/ubi-minimal as runtime
RUN mkdir -p /licenses
COPY LICENSE /licenses/
COPY --from=build /bin/kubevirt-cloud-controller-manager /bin/kubevirt-cloud-controller-manager

USER 65534

ENTRYPOINT ["/bin/kubevirt-cloud-controller-manager"]
